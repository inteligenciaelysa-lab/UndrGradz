




// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())

  email             String   @unique
  phone             String?  @unique
  handle            String?  @unique

  passwordHash      String

  firstName         String
  lastName          String

  birthDate         DateTime

  isEmailVerified   Boolean  @default(false)
  isPhoneVerified   Boolean  @default(false)
  isVerified        Boolean  @default(false) // Student ID verification badge 🎓 / ✅
  isCreatorVerified Boolean  @default(false) // Content Creator verification badge ✨
  isAthleteVerified Boolean  @default(false) // Campus Athlete verification badge 🏅
  isGovtVerified    Boolean  @default(false) // Student Government verification badge 🏛️

  // Administrative & Security fields
  role              String   @default("STUDENT") // 'STUDENT', 'SUPPORT', 'MODERATOR', 'ADMIN', 'SUPER_ADMIN'
  status            String   @default("ACTIVE")  // 'ACTIVE', 'SUSPENDED', 'BANNED', 'DELETED'
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?
  suspensionReason  String?
  suspendedUntil    DateTime?
  failedLoginAttempts Int    @default(0)
  lockoutUntil      DateTime?
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile           UserProfile?
  photos            Photo[]
  
  sentSwipes        Swipe[]  @relation("SentSwipes")
  receivedSwipes    Swipe[]  @relation("ReceivedSwipes")
  
  matchesOne        Match[]  @relation("UserOneMatches")
  matchesTwo        Match[]  @relation("UserTwoMatches")

  referralCode      String?  @unique
  referredById      String?
  referredBy        User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers     User[]   @relation("Referrals")
  
  sentFriendships     Friendship[]  @relation("SentFriendships")
  receivedFriendships Friendship[]  @relation("ReceivedFriendships")
  sentProfileViews    ProfileView[] @relation("SentViews")
  receivedProfileViews ProfileView[] @relation("ReceivedViews")
  messages            Message[]
  createdEvents       Event[]       @relation("CreatedEvents")
  joinedEvents        Event[]       @relation("EventAttendees")

  // Admin relations
  adminAuditLogs        AuditLog[]            @relation("AdminAuditLogs")
  reportsFiled          Report[]              @relation("ReportsFiled")
  reportsReceived       Report[]              @relation("ReportsReceived")
  resolvedReports       Report[]              @relation("ResolvedReports")
  adminSessions         AdminSession[]
  sentNotifications     Notification[]        @relation("SentNotifications")
  receivedNotifications Notification[]        @relation("ReceivedNotifications")
  verificationRequests  VerificationRequest[] @relation("UserVerificationRequests")
  reviewedVerifications VerificationRequest[] @relation("ReviewedVerifications")
}

model UserProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio              String?
  gender           String?   // 'MAN', 'WOMAN', 'NON_BINARY'
  interestedIn     String?   // 'MAN', 'WOMAN', 'EVERYONE'
  university       String?   // Legacy string representation
  universityId     String?
  universityRef    University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  major            String?   
  grad             String?   // Año de graduación, ej. "May '26"
  crossover        Boolean   @default(false)
  latitude         Float?
  longitude        Float?
  minAge           Int       @default(18)
  maxAge           Int       @default(26)
  maxDistanceKm    Int       @default(20)
  lastActive       DateTime  @default(now())
  isGhostMode      Boolean   @default(false)
  subscriptionTier String    @default("FREE") // 'FREE', 'GOLD', 'PLATINUM', 'APLUS'
  subscriptionEnds DateTime?
  // Which billing period was bought: 'mo' | '6mo' | 'yr'. Needed to rank the
  // subscription — a longer plan cannot be downgraded while it is still active,
  // only upgraded, and the tier alone doesn't say which one you are on.
  subscriptionPeriod String?
  boostEndsAt      DateTime?
  fcmToken         String?

  // Metadatos JSON estructurados
  interests        Json?     // Array de strings
  prompts          Json?     // Array de objetos { q: String, a: String }
  bucketList       Json?     // Array de strings
  identityTags     Json?     // Array de strings
  lookingForTags   Json?     // Array de strings
  lifestyle        Json?     // { diet, drinking, smoking, sports, workout, loveLanguage, zodiac }
  academic         Json?     // { minor, degree, advDegrees, company, clubs, backOnCampus... }
  background       Json?     // { religion, politics, ethnicity, pronouns, relationshipStatus }
  customization    Json?     // { accentText, anthem, cardStyle, badgeColor, uniNameColor... }
  socials          Json?     // { ig, website, otherlink }
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  order     Int
  createdAt DateTime @default(now())
}

model Swipe {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentSwipes", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedSwipes", fields: [receiverId], references: [id], onDelete: Cascade)
  type       String   // 'PASS', 'LIKE', 'SUPERLIKE', 'ROSE'
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Match {
  id              String   @id @default(cuid())
  userOneId       String
  userOne         User     @relation("UserOneMatches", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwoId       String
  userTwo         User     @relation("UserTwoMatches", fields: [userTwoId], references: [id], onDelete: Cascade)
  streamChannelId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  messages        Message[]

  @@unique([userOneId, userTwoId])
}

model Friendship {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   // 'PENDING', 'ACCEPTED', 'DECLINED'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String?
  type      String   @default("TEXT")
  mediaUrl  String?
  duration  Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  name        String
  emoji       String
  section     String   // 'nightlife', 'study', 'sports', 'networking'
  address     String
  time        String
  hostHandle  String
  capacity    Int
  description String?
  filters     Json?    // e.g. { majors: [], years: [] }
  status      String   @default("ACTIVE") // 'ACTIVE', 'HIDDEN', 'REJECTED'
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  creatorId   String
  creator     User     @relation("CreatedEvents", fields: [creatorId], references: [id], onDelete: Cascade)
  attendees   User[]   @relation("EventAttendees")
  reports     Report[] @relation("EventReports")
  createdAt   DateTime @default(now())
}

model ProfileView {
  id         String   @id @default(cuid())
  viewerId   String
  viewer     User     @relation("SentViews", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId   String
  viewed     User     @relation("ReceivedViews", fields: [viewedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([viewerId, viewedId])
}

model University {
  id             String        @id @default(cuid())
  domain         String        @unique
  name           String
  acronym        String
  type           String        @default("public") // 'public', 'private'
  primaryColor   String?
  secondaryColor String?
  website        String?
  coverPhotos    Json?         // Array of image URLs
  city           String?
  state          String?
  country        String        @default("Mexico")
  logoUrl        String?
  isOfficial     Boolean       @default(false)
  status         String        @default("AVAILABLE") // 'AVAILABLE', 'PENDING', 'INTEGRATED', 'SUSPENDED'
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  userProfiles   UserProfile[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([name])
  @@index([acronym])
  @@index([type])
  @@index([status])
}

model Report {
  id              String   @id @default(cuid())
  reporterId      String
  reporter        User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      String   // 'USER', 'EVENT', 'MESSAGE', 'PHOTO'
  targetId        String
  targetUserId    String?
  targetUser      User?    @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  eventId         String?
  event           Event?   @relation("EventReports", fields: [eventId], references: [id], onDelete: SetNull)
  reason          String   // 'SPAM', 'HARASSMENT', 'INAPPROPRIATE_CONTENT', 'FAKE_PROFILE', 'OTHER'
  details         String?
  status          String   @default("PENDING") // 'PENDING', 'UNDER_REVIEW', 'RESOLVED', 'DISMISSED'
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      User?    @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // e.g., 'USER_SUSPENDED', 'USER_ROLE_UPDATED', 'EVENT_HIDDEN'
  targetType String?  // 'USER', 'EVENT', 'REPORT', 'UNIVERSITY', 'SETTING'
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model AdminSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  deviceInfo String?
  lastActive DateTime @default(now())
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
}

model Notification {
  id               String   @id @default(cuid())
  senderId         String?
  sender           User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId      String?
  recipient        User?    @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  title            String
  message          String
  type             String   @default("SYSTEM") // 'SYSTEM', 'ANNOUNCEMENT', 'WARNING', 'MODERATION'
  targetUniversity String?
  targetCriteria   Json?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model VerificationRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  type            String    // 'STUDENT_ID', 'CREATOR_BADGE'
  status          String    @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'
  credentialUrl   String?   // Photo of Student ID / Credential card
  socialLinks     Json?     // { instagram, tiktok, youtube, twitch, x, followerCount, notes }
  creatorCategory String?   // 'Campus Vlogger', 'Gaming', 'Lifestyle', 'Tech', 'Student Athlete', etc.
  notes           String?   // User applicant message
  adminNotes      String?   // Notes left by admin reviewer
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewedVerifications", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}