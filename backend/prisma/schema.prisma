generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  phone                 String?               @unique
  passwordHash          String
  firstName             String
  lastName              String
  birthDate             DateTime
  isEmailVerified       Boolean               @default(false)
  isPhoneVerified       Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  referralCode          String?               @unique
  referredById          String?
  handle                String?               @unique
  deletedAt             DateTime?
  failedLoginAttempts   Int                   @default(0)
  isDeleted             Boolean               @default(false)
  lockoutUntil          DateTime?
  role                  String                @default("STUDENT")
  status                String                @default("ACTIVE")
  suspendedUntil        DateTime?
  suspensionReason      String?
  twoFactorEnabled      Boolean               @default(false)
  twoFactorSecret       String?
  isCreatorVerified     Boolean               @default(false)
  isVerified            Boolean               @default(false)
  isAthleteVerified     Boolean               @default(false)
  isGovtVerified        Boolean               @default(false)
  banReason             String?
  bannedAt              DateTime?
  bannedById            String?
  suspendedAt           DateTime?
  suspendedById         String?
  adminSessions         AdminSession[]
  appealsResolved       Appeal[]              @relation("AppealsResolved")
  appealsFiled          Appeal[]              @relation("AppealsFiled")
  adminAuditLogs        AuditLog[]            @relation("AdminAuditLogs")
  createdEvents         Event[]               @relation("CreatedEvents")
  receivedFriendships   Friendship[]          @relation("ReceivedFriendships")
  sentFriendships       Friendship[]          @relation("SentFriendships")
  matchesOne            Match[]               @relation("UserOneMatches")
  matchesTwo            Match[]               @relation("UserTwoMatches")
  messages              Message[]
  receivedNotifications Notification[]        @relation("ReceivedNotifications")
  sentNotifications     Notification[]        @relation("SentNotifications")
  photos                Photo[]
  receivedProfileViews  ProfileView[]         @relation("ReceivedViews")
  sentProfileViews      ProfileView[]         @relation("SentViews")
  reportsFiled          Report[]              @relation("ReportsFiled")
  resolvedReports       Report[]              @relation("ResolvedReports")
  reportsReceived       Report[]              @relation("ReportsReceived")
  receivedSwipes        Swipe[]               @relation("ReceivedSwipes")
  sentSwipes            Swipe[]               @relation("SentSwipes")
  bannedBy              User?                 @relation("BannedByAdmin", fields: [bannedById], references: [id])
  bansIssued            User[]                @relation("BannedByAdmin")
  referredBy            User?                 @relation("Referrals", fields: [referredById], references: [id])
  referredUsers         User[]                @relation("Referrals")
  suspendedBy           User?                 @relation("SuspendedByAdmin", fields: [suspendedById], references: [id])
  suspensionsIssued     User[]                @relation("SuspendedByAdmin")
  profile               UserProfile?
  reviewedVerifications VerificationRequest[] @relation("ReviewedVerifications")
  verificationRequests  VerificationRequest[] @relation("UserVerificationRequests")
  joinedEvents          Event[]               @relation("EventAttendees")
}

model UserProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  bio                String?
  gender             String?
  interestedIn       String?
  latitude           Float?
  longitude          Float?
  minAge             Int         @default(18)
  maxAge             Int         @default(26)
  maxDistanceKm      Int         @default(20)
  lastActive         DateTime    @default(now())
  isGhostMode        Boolean     @default(false)
  boostEndsAt        DateTime?
  subscriptionEnds   DateTime?
  subscriptionTier   String      @default("FREE")
  fcmToken           String?
  academic           Json?
  background         Json?
  bucketList         Json?
  crossover          Boolean     @default(false)
  customization      Json?
  grad               String?
  identityTags       Json?
  interests          Json?
  lifestyle          Json?
  lookingForTags     Json?
  major              String?
  prompts            Json?
  socials            Json?
  university         String?
  universityId       String?
  subscriptionPeriod String?
  verifiedSports     Json?
  campusId           String?
  campusRef          Campus?     @relation(fields: [campusId], references: [id])
  universityRef      University? @relation(fields: [universityId], references: [id])
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  order     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Swipe {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  type       String
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedSwipes", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentSwipes", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Match {
  id              String    @id @default(cuid())
  userOneId       String
  userTwoId       String
  streamChannelId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  userOne         User      @relation("UserOneMatches", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo         User      @relation("UserTwoMatches", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages        Message[]
  reports         Report[]

  @@unique([userOneId, userTwoId])
}

model Friendship {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  content   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  duration  Int?
  mediaUrl  String?
  type      String   @default("TEXT")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Event {
  id          String    @id @default(cuid())
  name        String
  emoji       String
  section     String
  address     String
  time        String
  hostHandle  String
  capacity    Int
  description String?
  filters     Json?
  creatorId   String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  isDeleted   Boolean   @default(false)
  status      String    @default("ACTIVE")
  creator     User      @relation("CreatedEvents", fields: [creatorId], references: [id], onDelete: Cascade)
  reports     Report[]  @relation("EventReports")
  attendees   User[]    @relation("EventAttendees")
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  viewed    User     @relation("ReceivedViews", fields: [viewedId], references: [id], onDelete: Cascade)
  viewer    User     @relation("SentViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
}

model University {
  id             String             @id @default(cuid())
  name           String
  domain         String             @unique
  city           String?
  state          String?
  country        String             @default("Mexico")
  logoUrl        String?
  isOfficial     Boolean            @default(false)
  status         String             @default("AVAILABLE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  acronym        String
  coverPhotos    Json?
  deletedAt      DateTime?
  isDeleted      Boolean            @default(false)
  primaryColor   String?
  secondaryColor String?
  type           String             @default("public")
  website        String?
  campuses       Campus[]
  domains        UniversityDomain[]
  userProfiles   UserProfile[]

  @@index([name])
  @@index([acronym])
  @@index([type])
  @@index([status])
}

model UniversityDomain {
  id           String     @id @default(cuid())
  universityId String
  domain       String     @unique
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model Campus {
  id           String        @id @default(cuid())
  universityId String
  name         String
  city         String?
  state        String?
  country      String?       @default("Mexico")
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  userProfiles UserProfile[]

  @@index([universityId])
}

model Report {
  id               String   @id @default(cuid())
  reporterId       String
  targetType       String
  targetId         String
  targetUserId     String?
  eventId          String?
  reason           String
  details          String?
  status           String   @default("PENDING")
  resolutionNotes  String?
  resolvedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  evidenceSnapshot Json?
  matchId          String?
  event            Event?   @relation("EventReports", fields: [eventId], references: [id])
  match            Match?   @relation(fields: [matchId], references: [id])
  reporter         User     @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy       User?    @relation("ResolvedReports", fields: [resolvedById], references: [id])
  targetUser       User?    @relation("ReportsReceived", fields: [targetUserId], references: [id])
}

model Appeal {
  id               String    @id @default(cuid())
  userId           String
  moderationStatus String
  originalReason   String?
  message          String
  status           String    @default("PENDING")
  resolutionNotes  String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resolvedBy       User?     @relation("AppealsResolved", fields: [resolvedById], references: [id])
  user             User      @relation("AppealsFiled", fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  admin      User?    @relation("AdminAuditLogs", fields: [adminId], references: [id])
}

model AdminSession {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  deviceInfo String?
  lastActive DateTime @default(now())
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  tokenHash  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
}

model Notification {
  id               String   @id @default(cuid())
  senderId         String?
  recipientId      String?
  title            String
  message          String
  type             String   @default("SYSTEM")
  targetUniversity String?
  targetCriteria   Json?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
  recipient        User?    @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender           User?    @relation("SentNotifications", fields: [senderId], references: [id])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model VerificationRequest {
  id              String    @id @default(cuid())
  userId          String
  type            String
  status          String    @default("PENDING")
  credentialUrl   String?
  socialLinks     Json?
  creatorCategory String?
  notes           String?
  adminNotes      String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  documentMime    String?
  documentName    String?
  metadata        Json?
  sport           String?
  reviewedBy      User?     @relation("ReviewedVerifications", fields: [reviewedById], references: [id])
  user            User      @relation("UserVerificationRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([status, createdAt])
}
