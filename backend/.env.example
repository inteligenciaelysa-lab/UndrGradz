# Copy this file to .env for local development and fill in real values.
# Never commit the actual .env file (it is already gitignored).

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database (Prisma / PostgreSQL) ----
# LOCAL DEV (via Cloud SQL Auth Proxy running on localhost:5433):
#   DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/undrgradz"
#
# CLOUD RUN (Unix socket via --add-cloudsql-instances, no proxy container needed):
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost/undrgradz?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME"
#
# In Cloud Run this is provided via Secret Manager (--set-secrets), not as a plain env var.
DATABASE_URL="postgresql://postgres:Nx%2F-VDl8V%282t%40mKB@127.0.0.1:5433/undrgradz"

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret

# ---- Stream Chat ----
STREAM_APP_KEY=changeme
STREAM_APP_SECRET=changeme

# ---- Google Cloud Storage (uploads) ----
# Required in production (NODE_ENV=production or running on Cloud Run, where the
# K_SERVICE env var is injected automatically) so uploads use real signed GCS URLs
# instead of the local-disk mock-upload path, which does not work on Cloud Run's
# ephemeral, per-instance filesystem.
#
# On Cloud Run, authentication uses Application Default Credentials via the service
# account attached to the service — do NOT set GOOGLE_APPLICATION_CREDENTIALS there.
GCS_BUCKET_NAME=

# ---- Firebase Admin (push notifications) ----
FIREBASE_PROJECT_ID=changeme
FIREBASE_CLIENT_EMAIL=changeme@changeme.iam.gserviceaccount.com
# Private key must contain literal \n sequences (not actual newlines) when stored as one line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ---- Redis (Socket.io adapter, for multi-instance deployments) ----
# Leave unset for local development: Socket.io falls back to its in-memory adapter,
# which is fine for a single process/instance.
# In Cloud Run, point this at a Memorystore for Redis instance reachable via a
# Serverless VPC Access connector, e.g.: redis://10.0.0.3:6379
REDIS_URL=
