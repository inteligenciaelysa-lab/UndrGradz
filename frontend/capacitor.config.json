{
  "appId": "com.undrgradz.app",
  "appName": "UndrGradz",
  "webDir": "www",
  "server": {
    "iosScheme": "https",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 350,
      "backgroundColor": "#0a0520",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "none",
      "style": "DARK",
      "accessoryBarVisible": false
    }
  }
}
